# Copy this file to .env on the SERVER only.
# Never put these values in the Android app, the website, or git.
#
#   cp .env.example .env
#
# The app reads them from the environment. You do not need to edit source code.

# Required. Gemini secret. Server only. Never put this in the Android app.
GEMINI_API_KEY=

# Optional file-based secret (Docker/K8s). Used only if GEMINI_API_KEY is empty.
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# Optional alias. Used only if GEMINI_API_KEY is empty.
# AI_API_KEY=
# AI_API_KEY_FILE=/run/secrets/ai_api_key

# Provider base URL.
# Gemini:    https://generativelanguage.googleapis.com/v1beta
# OpenAI:    https://api.openai.com/v1
# Groq:      https://api.groq.com/openai/v1
# OpenRouter:https://openrouter.ai/api/v1
# Anthropic: https://api.anthropic.com
# Ollama:    http://127.0.0.1:11434/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Model name from your provider.
# Current Gemini text/vision model: gemini-3.8-flash
# Other examples: gpt-4o-mini, claude-3-5-haiku-latest
AI_MODEL=gemini-3.8-flash

# auto | openai | anthropic | gemini
# "openai" means any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Together, Ollama).
AI_PROVIDER=gemini

# Optional Gemini thinking level: low | medium | high
# "minimal" is not valid for Gemini 3 and is treated as low.
# AI_THINKING=low

# Vision: auto | on | off
# Optional separate model used only when the user attaches an image.
AI_VISION=auto
AI_VISION_MODEL=

# Optional web search. If unset, Sana uses a DuckDuckGo fallback and never invents results.
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

PORT=8080
AI_TIMEOUT_MS=55000
AI_MAX_TOKENS=1800

# Set to 1 only when Sana is behind a reverse proxy.
TRUST_PROXY=0
